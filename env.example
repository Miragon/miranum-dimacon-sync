# ───────────────────────────────────────────────────────────────────────────
# miranum-dimacon-sync — env template
#
# Copy to `.env` and fill in. `.env` is gitignored. dotenv loads `.env` at
# server boot and *augments* the process env — values already set in the
# environment (e.g. `fly secrets`) are NOT overwritten.
# ───────────────────────────────────────────────────────────────────────────

PORT=3020


# ─── Datenbank ────────────────────────────────────────────────────────────
# Postgres (Drizzle). Lokal: `pnpm stack:up` (stack/docker-compose.yml) →
# der Default unten passt. Migrationen laufen automatisch beim Boot.
# Produktion (NODE_ENV=production) startet NUR mit gesetztem DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5400/miranum_sync


# ─── Credential-Verschlüsselung ───────────────────────────────────────────
# Key-Ring für die AES-256-GCM-Verschlüsselung der Mandanten-API-Tokens.
# Komma-Liste "<keyId>=<base64-32-Byte>", keyId numerisch. Der LINKESTE
# Eintrag verschlüsselt neue Writes; alle Einträge können entschlüsseln.
# Rotation: neuen Key vorn anstellen, Re-Encrypt-Sweep fahren
# (src/server/db/rotate-credentials.ts), alten Key erst danach entfernen.
# Erzeugen: openssl rand -base64 32
# Produktion startet NUR mit gesetztem CREDENTIAL_KEYS.
CREDENTIAL_KEYS=1=


# ─── WorkOS Authentication ────────────────────────────────────────────────
# Die Client-ID ist ein Public Client: dieselbe ID konsumieren SPA (VITE_*,
# build-time ins Bundle gebakt) und Hono-Backend (Laufzeit, JWKS-Fetch).
# Der optionale WORKOS_API_KEY (s. u.) ist dagegen ein echtes Server-Secret.
#
# Produktion (NODE_ENV=production) startet NUR mit gesetztem
# WORKOS_CLIENT_ID (+ DATABASE_URL + CREDENTIAL_KEYS, s. o.).
# Im Dev optional (App läuft dann offen mit einem lokalen Dev-Mandanten).
#
# Mandanten-Modell: eine WorkOS-Organisation = ein Mandant. Die Zugangs-
# Allowlist ist die tenants-Tabelle in Postgres — Anlage per
# `TENANT_WEBHOOK_SECRET=<secret> pnpm exec tsx scripts/create-tenant.ts \
#    --org-id org_… --name "…"`
# TENANT_WEBHOOK_SECRET (optional) wird gehasht als Webhook-Secret des
# Mandanten hinterlegt — bewusst via Env, nie als CLI-Argument (argv landet
# in Shell-History und Prozessliste). Keine .env-Variable, nur Script-Input.

# Client ID from the WorkOS dashboard (starts with `client_`)
WORKOS_CLIENT_ID=
VITE_WORKOS_CLIENT_ID=

# Optionale AuthKit-Custom-Domain (z. B. auth.example.com, im WorkOS-
# Dashboard eingerichtet und verifiziert). Gesetzt = Session- und
# Refresh-Cookie liegen First-Party auf derselben Site wie die App: der
# Refresh trägt über Page-Loads hinweg und der stille Roundtrip über die
# Hosted-Login-Seite bei jedem Reload entfällt. Leer = api.workos.com
# (Cross-Site-Cookie; in Safari/mit blockierten Third-Party-Cookies scheitert
# der Refresh). Achtung: der Wert wird build-time ins Bundle gebakt — per
# `fly secrets` NICHT nachrüstbar, nur per Rebuild (Docker-Build-Arg).
VITE_WORKOS_API_HOSTNAME=

# Optionaler server-only API-Key (sk_…, WorkOS-Dashboard → API Keys, je
# Environment eigener Key). Filtert die Mandanten-Switcher-Liste
# (/api/tenants) nach den tatsächlichen Org-Mitgliedschaften des Users.
# Leer = Switcher zeigt nur den aktiven Mandanten (Multi-Org-Wechsel aus).
# NIE als VITE_* exportieren — echtes Secret.
WORKOS_API_KEY=

# "on" = Org-Sync: WorkOS-Orgs mit Feature-Flag `dimacon-sync` werden
# automatisch als Mandanten provisioniert/deaktiviert (2-min-Reconcile,
# braucht WORKOS_API_KEY; Details README → Multi-Mandanten-Modell).
WORKOS_ORG_SYNC=

# ─── Rate-Limits & Parallelität (optional) ────────────────────────────────
# Zwei Bremsen: der Token-Bucket je (Mandant, System) gilt für den ganzen
# Lauf, CONCURRENCY_<SYS> dagegen nur JE PHASE — `createLimit` baut an jeder
# Aufrufstelle ein eigenes p-limit (bei gemischten Tasks zählt das strengste
# beteiligte System). Phasen, die nebeneinander laufen, addieren ihre Töpfe:
# im dimacon-clockin-Lauf läuft der Mitarbeiter-Abgleich neben der
# Tagesplanung, dort sind bis zu 2 × CONCURRENCY_CLOCKIN + 1 Clockin-Requests
# gleichzeitig offen. Alles optional; leer/ungültig/≤0 ⇒ Default; Bruchwerte
# unter 1 werden auf 1 geklemmt. Konservativ gewählt: Lexware Office erlaubt
# laut Doku 2 Requests/Sekunde, die Limits von Dimacon und Clockin sind nicht
# dokumentiert. Die Phasen-Metriken jedes Laufs (sync_runs.result.metrics)
# zeigen, ob mehr geht.
# RATE_LIMIT_DIMACON_RPS=10
# RATE_LIMIT_DIMACON_BURST=20
# CONCURRENCY_DIMACON=8
# RATE_LIMIT_CLOCKIN_RPS=5
# RATE_LIMIT_CLOCKIN_BURST=10
# CONCURRENCY_CLOCKIN=5
# RATE_LIMIT_LEXOFFICE_RPS=2
# RATE_LIMIT_LEXOFFICE_BURST=2
# CONCURRENCY_LEXOFFICE=2

# ─── Archiv-Horizont (optional) ───────────────────────────────────────────
# Planungshorizont des Archiv-Schutzes im dimacon-clockin-Sync, in Tagen und
# in BEIDE Richtungen — das Fenster reicht von N Tagen vor dem früheren bis N
# Tage nach dem späteren der beiden Daten `heute` und `Sync-Datum`. Ein
# Clockin-Projekt wird nur archiviert, wenn es in diesem ganzen Fenster keinen
# Dimacon-Termin hat —
# sonst pendelten wiederkehrende Projekte täglich zwischen archiviert und
# aktiv. Leer/ungültig/≤0 ⇒ Default 14. Größer = vorsichtiger.
# ARCHIVE_HORIZON_DAYS=14

# Redirect URIs + allowed origins are configured in the WorkOS dashboard,
# not here. For dev add `http://localhost:3000`; for prod the deployed URL.


# ─── Legacy / einmaliger Seed ─────────────────────────────────────────────
# Alles ab hier ist KEINE Laufzeit-Konfiguration mehr. Beim allerersten Boot
# gegen eine leere Datenbank importiert der Legacy-Seed diese Werte einmalig
# in den ersten Mandanten (verschlüsselt in tenant_credentials, Schedules +
# Feld-Zuordnungen aus SETTINGS_PATH, sha256 des Webhook-Secrets). Danach
# werden sie nicht mehr gelesen — nach verifiziertem Seed entfernen
# (`fly secrets unset …`), sonst kann ein DB-Reset veraltete Tokens
# wiederbeleben.

# Org des ersten Mandanten (der Seed braucht sie; ohne = kein Seed)
# WORKOS_REQUIRED_ORG_ID=

# ClockIn
# CLOCKIN_API_TOKEN=
# CLOCKIN_BASE_URL=    # optional override

# Dimacon — full URL including scheme, e.g. http://localhost:8080
# DIMACON_BASE_URL=
# DIMACON_TENANT=
# DIMACON_API_TOKEN=

# Lexware Office
# LEXWARE_OFFICE_API_KEY=
# LEXWARE_OFFICE_BASE_URL=    # optional override

# Alte settings.json (Schedules + Feld-Zuordnungen) — wird nur gelesen
# SETTINGS_PATH=./data/settings.json
# SYNC_CRON="0 6 * * *"
# SYNC_TZ="Europe/Berlin"

# Webhook-Secret der externen Caller — wandert als Hash zum ersten Mandanten
# SYNC_WEBHOOK_SECRET=

# Anzeigename des ersten Mandanten (Default: die Org-Id)
# SEED_TENANT_NAME=
